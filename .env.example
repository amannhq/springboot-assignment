# ============================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# Active Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Server port (optional, defaults to 8080 in prod)
SERVER_PORT=8080

# MongoDB Connection String
# For Atlas: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
# For Local: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017/rideshare
MONGODB_DATABASE=rideshare

# JWT Secret Key (minimum 256 bits / 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-at-least-256-bits-long
JWT_EXPIRATION=86400000
