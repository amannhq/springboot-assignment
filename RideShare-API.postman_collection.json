									"});",
									"",
									"pm.test('Ride status is COMPLETED', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('COMPLETED');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{userToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/rides/{{rideId}}/complete",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "rides", "{{rideId}}", "complete"]
						},
						"description": "Complete a ride (must be in ACCEPTED status)"
					},
					"response": []
				}
			],
			"description": "User (Passenger) endpoints"
