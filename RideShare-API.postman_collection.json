		{
			"name": "User (Passenger)",
			"item": [
				{
					"name": "Create Ride",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('rideId', jsonData.id);",
									"}",
									"",
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Ride status is REQUESTED', function () {",
									"    pm.expect(jsonData.status).to.eql('REQUESTED');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{userToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"pickupLocation\": \"Koramangala\",\n    \"dropLocation\": \"Indiranagar\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/rides",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "rides"]
						},
						"description": "Create a new ride request (USER only)"
					},
					"response": []
				},
				{
					"name": "Get My Rides",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response is an array', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{userToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/user/rides",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "user", "rides"]
						},
						"description": "Get all rides for the logged-in user"
					},
					"response": []
				},
				{
					"name": "Complete Ride (User)",
